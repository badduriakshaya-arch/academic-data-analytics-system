# ============================================================
# STUDENTS ACADEMIC DATA ANALYSIS SYSTEM
# ============================================================


# ============================================================
# STEP 1: IMPORT LIBRARIES
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from google.colab import files
from IPython.display import display


# ============================================================
# STEP 2: UPLOAD EXCEL DATASET
# ============================================================

print("Please upload your Excel dataset:")

uploaded = files.upload()

file_name = list(uploaded.keys())[0]

# Read Excel file
df = pd.read_excel(file_name)

print("\nOriginal Dataset:")
display(df.head())


# ============================================================
# STEP 3: DATA CLEANING
# ============================================================

# Remove duplicate rows
df = df.drop_duplicates()

print("\nNumber of rows after removing duplicates:", len(df))

# Display missing values
print("\nMissing Values:")
print(df.isnull().sum())


# ============================================================
# STEP 4: DATA PREPROCESSING
# ============================================================

# Subject columns
subjects = ['C++', 'DBMS', 'DAE', 'ADS']

# Convert subject marks into numbers
for column in subjects:
    df[column] = pd.to_numeric(df[column], errors='coerce')

# Convert assignment and internal average into numbers
df['Assignment_Avg'] = pd.to_numeric(
    df['Assignment_Avg'], errors='coerce'
)

df['Internal_Avg'] = pd.to_numeric(
    df['Internal_Avg'], errors='coerce'
)

# Fill missing numerical values with column mean
numeric_columns = df.select_dtypes(include=np.number).columns

for column in numeric_columns:
    df[column] = df[column].fillna(df[column].mean())


print("\nDataset after preprocessing:")
display(df.head())


# ============================================================
# STEP 5: CALCULATE PERFORMANCE SCORE
# ============================================================

# Performance Score is calculated using:
# C++, DBMS, DAE, ADS,
# Assignment Average and Internal Average

df['Performance_Score'] = np.mean(
    df[
        ['C++', 'DBMS', 'DAE', 'ADS',
         'Assignment_Avg', 'Internal_Avg']
    ],
    axis=1
)

# Round the score to 2 decimal places
df['Performance_Score'] = df['Performance_Score'].round(2)


# ============================================================
# STEP 6: CALCULATE RESULT
# ============================================================

# Pass only when the student scores MORE THAN 40
# in ALL four subjects.

df['Result'] = np.where(
    (df['C++'] > 40) &
    (df['DBMS'] > 40) &
    (df['DAE'] > 40) &
    (df['ADS'] > 40),
    'Pass',
    'Fail'
)


# ============================================================
# STEP 7: CALCULATE PERFORMANCE STATUS
# ============================================================

# Calculate class average Performance Score

class_average = df['Performance_Score'].mean()

# Compare every student's score with class average

df['Performance_Status'] = np.where(
    df['Performance_Score'] > class_average,
    'Good',
    'Need Improvement'
)


# ============================================================
# STEP 8: DISPLAY CALCULATED RESULTS
# ============================================================

print("\nClass Average Performance Score:",
      round(class_average, 2))

print("\nFinal Calculated Data:")
display(df)


# ============================================================
# STEP 9: BASIC ANALYSIS
# ============================================================

total_students = len(df)

passed_students = (df['Result'] == 'Pass').sum()

failed_students = (df['Result'] == 'Fail').sum()

average_attendance = df['Attendance'].mean()

average_cgpa = df['CGPA'].mean()

average_performance = df['Performance_Score'].mean()


print("\n================ BASIC ANALYSIS ================")

print("Total Students:", total_students)

print("Passed Students:", passed_students)

print("Failed Students:", failed_students)

print("Average Attendance:",
      round(average_attendance, 2))

print("Average CGPA:",
      round(average_cgpa, 2))

print("Average Performance Score:",
      round(average_performance, 2))


# ============================================================
# VISUALIZATION 1
# AVERAGE MARKS OF SUBJECTS
# ============================================================

average_marks = df[subjects].mean()

plt.figure(figsize=(8, 5))

plt.bar(
    average_marks.index,
    average_marks.values
)

plt.title("Average Marks in Each Subject")
plt.xlabel("Subjects")
plt.ylabel("Average Marks")

plt.show()


# ============================================================
# VISUALIZATION 2
# PASS / FAIL PIE CHART
# ============================================================

result_count = df['Result'].value_counts()

plt.figure(figsize=(6, 6))

plt.pie(
    result_count.values,
    labels=result_count.index,
    autopct='%1.1f%%'
)

plt.title("Pass and Fail Percentage")

plt.show()


# ============================================================
# VISUALIZATION 3
# PERFORMANCE SCORE HISTOGRAM
# ============================================================

plt.figure(figsize=(8, 5))

plt.hist(
    df['Performance_Score'],
    bins=10,
    edgecolor='black'
)

plt.title("Distribution of Performance Scores")
plt.xlabel("Performance Score")
plt.ylabel("Number of Students")

plt.show()


# ============================================================
# VISUALIZATION 4
# ATTENDANCE VS CGPA
# ============================================================

plt.figure(figsize=(8, 5))

plt.scatter(
    df['Attendance'],
    df['CGPA']
)

plt.title("Attendance vs CGPA")
plt.xlabel("Attendance")
plt.ylabel("CGPA")

plt.show()


# ============================================================
# VISUALIZATION 5
# PROJECTS VS PERFORMANCE SCORE
# ============================================================

project_performance = df.groupby(
    'Projects'
)['Performance_Score'].mean()

plt.figure(figsize=(8, 5))

plt.bar(
    project_performance.index.astype(str),
    project_performance.values
)

plt.title("Projects vs Average Performance Score")
plt.xlabel("Number of Projects")
plt.ylabel("Average Performance Score")

plt.show()


# ============================================================
# STEP 10: DISPLAY FINAL COLUMNS
# ============================================================

print("\nFinal Dataset Columns:")

print(df.columns.tolist())


# ============================================================
# STEP 11: SAVE FINAL EXCEL FILE
# ============================================================

output_file = "Final_Students_Academic_Data.xlsx"

df.to_excel(
    output_file,
    index=False
)

print("\n================================================")
print("Final Excel file created successfully!")
print("================================================")

print("\nThe final Excel file contains:")
print("- Original student data")
print("- Performance_Score")
print("- Result")
print("- Performance_Status")


# ============================================================
# STEP 12: DOWNLOAD FINAL EXCEL FILE
# ============================================================

files.download(output_file)
